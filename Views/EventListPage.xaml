<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Campus.Views.EventListPage"
             Title="Campus Events"
             BackgroundColor="#F7FAFC">

    <Grid RowDefinitions="Auto, *" Padding="0">

        <!-- HEADER -->
        <VerticalStackLayout Grid.Row="0" 
                             BackgroundColor="#00697F" 
                             Padding="20,15">
            <Label Text="🎓 Campus Events"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"/>
            <Label Text="Discover upcoming events near you"
                   FontSize="13"
                   TextColor="#B2DFDB"
                   HorizontalOptions="Center"
                   Margin="0,5,0,0"/>
        </VerticalStackLayout>

        <!-- EVENT LIST AREA -->
        <CollectionView Grid.Row="1"
                        x:Name="EventsCollection"
                        Margin="10,10,10,0"
                        SelectionMode="Single">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/>
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <!-- EVENT CARD -->
                    <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="White"
                Padding="0"
                Margin="5,0"
                Shadow="{OnPlatform Default='0,3,10,#18000000'}">

                        <Grid RowDefinitions="160, Auto" ColumnDefinitions="*">

                            <!-- Event Image -->
                            <Image Grid.Row="0"
                       Source="{Binding ImageUrl}"
                       Aspect="AspectFill"
                       HeightRequest="160"/>

                            <!-- Category Badge (overlay on image) -->
                            <Border Grid.Row="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#00697F"
                        Padding="10,5"
                        HorizontalOptions="Start"
                        VerticalOptions="End"
                        Margin="12,0,0,10">
                                <Label Text="{Binding Category}"
                           FontSize="11"
                           TextColor="White"
                           FontAttributes="Bold"/>
                            </Border>

                            <!-- Event Info -->
                            <VerticalStackLayout Grid.Row="1" 
                                     Padding="15,12"
                                     Spacing="4">
                                <Label Text="{Binding Title}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="#1A202C"/>
                                <Label Text="{Binding Description}"
                           FontSize="13"
                           TextColor="#718096"
                           MaxLines="2"
                           LineBreakMode="TailTruncation"/>

                                <BoxView HeightRequest="1" 
                             Color="#EDF2F7" 
                             Margin="0,8,0,5"/>

                                <HorizontalStackLayout Spacing="15">
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="📍" FontSize="12"/>
                                        <Label Text="{Binding Location}"
                                   FontSize="12"
                                   TextColor="#4A5568"/>
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="5">
                                        <Label Text="📅" FontSize="12"/>
                                        <Label Text="{Binding DateTime, StringFormat='{0:dd MMM yyyy}'}"
                                   FontSize="12"
                                   TextColor="#4A5568"/>
                                    </HorizontalStackLayout>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>


        </CollectionView>

    </Grid>

</ContentPage>
